{
  "name": "reporta",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "cf:build": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "test": "vitest run",
    "db:seed:generate": "tsx scripts/generate-seed.ts",
    "db:seed:local": "tsx scripts/generate-seed.ts && wrangler d1 execute DB --local --file db/seed/seed.sql"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@langchain/core": "^1.5.1",
    "@langchain/langgraph": "^1.7.5",
    "@langchain/langgraph-checkpoint": "^1.2.3",
    "@opennextjs/cloudflare": "^1.20.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^0.563.0",
    "next": "16.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^3.8.5",
    "tailwind-merge": "^3.7.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.4",
    "wrangler": "^4.168.0"
  }
}
